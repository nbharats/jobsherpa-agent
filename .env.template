
# Application
APP_ENV=development
LOG_LEVEL=INFO
DRY_RUN=True

# Candidate and job search
JOB_LOCATION=India
JOB_KEYWORDS=Python Developer,Frontend Developer,React Developer,Full Stack Developer,Software Engineer,AI Engineer
JOB_SCORE_THRESHOLD=7
TOP_N_JOBS=10

# Daily limits
MAX_APPLY_PER_DAY=5
MAX_COLD_EMAILS_PER_DAY=3

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Gmail
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
REPORT_EMAIL=

# Email server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

HR_EMAIL_LOCALPARTS=hr,careers,jobs

# Database
DATABASE_PATH=data/jobsherpa.db


# Rate limits and email pacing
GEMINI_MAX_RPM=12
EMAIL_DELAY_MIN_SECONDS=15
EMAIL_DELAY_MAX_SECONDS=30

# Scheduler
SCHEDULE_TIME=09:00
TIMEZONE=Asia/Kolkata

# Filter rules
BLACKLIST_KEYWORDS=java,php,wordpress,sales,bpo
WHITELIST_KEYWORDS=python,react,flask,javascript,full stack,ai,ml
MAX_YEARS_REQUIRED=2

# Optional third-party APIs (leave blank if unused)
APOLLO_API_KEY=
SNOV_API_KEY=
TAVILY_API_KEY=

SCRAPER_TIMEOUT_SECONDS=20
CACHE_TTL_HOURS=12

SENIOR_KEYWORDS=senior,sr,lead,principal,staff,director,vp,vice president,head of,chief,cto,manager,architect